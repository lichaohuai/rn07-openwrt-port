#!/bin/sh /etc/rc.common
START=99
start() {
 # First install is acknowledged manually after checking mounted persistence.
 # Subsequent accepted boots clear the bootloader's in-progress failure flag.
 [ "$(fw_printenv -n flag_last_success 2>/dev/null)" = 1 ] || return 0
 [ "$(fw_printenv -n flag_boot_success 2>/dev/null)" = 1 ] || return 0
 [ "$(fw_printenv -n flag_ota_reboot 2>/dev/null)" = 0 ] || return 0
 /usr/sbin/rn07-boot-control accept > /tmp/rn07-boot-ack.log 2>&1
}
