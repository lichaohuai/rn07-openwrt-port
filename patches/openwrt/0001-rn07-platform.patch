diff --git a/target/linux/ipq50xx/image/Makefile b/target/linux/ipq50xx/image/Makefile
index 701a62d..bec58cf 100644
--- a/target/linux/ipq50xx/image/Makefile
+++ b/target/linux/ipq50xx/image/Makefile
@@ -88,4 +88,41 @@ define Device/xiaomi_cr881x
 endef
 TARGET_DEVICES += xiaomi_cr881x
 
+# RN07 first-stage candidate: ARM initramfs only; no persistent image.
+ifeq ($(SUBTARGET),arm)
+define Device/xiaomi_rn07
+  $(call Device/FitImage)
+  SOC := ipq5018
+  DEVICE_VENDOR := Xiaomi
+  DEVICE_MODEL := AX3000E
+  DEVICE_VARIANT := RN07 experimental RAM bring-up
+  DEVICE_DTS_CONFIG := config@mp03.3
+  IMAGES :=
+  DEVICE_PACKAGES := -uboot-envtools -kmod-ath11k -kmod-ath11k-ahb -kmod-ath11k-pci -wpad-basic-wolfssl
+endef
+TARGET_DEVICES += xiaomi_rn07
+
+# Separate diagnostic profile preserves the first tested, no-radio profile.
+define Device/xiaomi_rn07_diag
+  $(call Device/FitImage)
+  SOC := ipq5018
+  DEVICE_VENDOR := Xiaomi
+  DEVICE_MODEL := AX3000E
+  DEVICE_VARIANT := RN07 wireless diagnostic, read-only ART
+  DEVICE_DTS := ipq5018-rn07-diag
+  DEVICE_DTS_CONFIG := config@mp03.3
+  IMAGES :=
+  DEVICE_PACKAGES := -uboot-envtools -kmod-ath11k-pci -wpad-basic-wolfssl kmod-ath11k kmod-ath11k-ahb wpad-basic-mbedtls
+endef
+TARGET_DEVICES += xiaomi_rn07_diag
+
+# Phase3 stock-radio experiment; preserve both earlier candidate profiles.
+define Device/xiaomi_rn07_stockdiag
+  $(call Device/xiaomi_rn07_diag)
+  DEVICE_VARIANT := RN07 stock-radio diagnostic, read-only ART
+  DEVICE_DTS := ipq5018-rn07-stockdiag
+endef
+TARGET_DEVICES += xiaomi_rn07_stockdiag
+endif
+
 $(eval $(call BuildImage))
