/* Offline RN07 candidate; not a validated port or installation image.
 * Based on CR881x plus RN07 stock 1.0.24 DTB and yt_switch.ko evidence.
 * Flash and radio nodes remain disabled for initial RAM-only bring-up.
 * See docs/VALIDATION.md for the historical profile and remaining limits.
 */

/dts-v1/;

#include "ipq5018.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "Xiaomi AX3000E (RN07) RAM bring-up";
	compatible = "xiaomi,rn07", "qcom,ipq5018";

	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&intc>;

	memory@40000000 {
		device_type = "memory";
		/* Captured stock runtime FDT: 256 MiB, not the generic 512 MiB. */
		reg = <0 0x40000000 0 0x10000000>;
	};

	aliases {
		serial0 = &blsp1_uart1;

		ethernet0 = &mac0;
		ethernet1 = &mac1;

		led-boot = &led_system_blue;
		led-failsafe = &led_system_orange;
		led-running = &led_system_blue;
		led-upgrade = &led_system_orange;
	};

	chosen {
		// Never select a persistent rootfs in the RAM-only candidate.
		bootargs = "console=ttyMSM0,115200n8";
		bootargs-append = " root=/dev/ram0 rdinit=/init";
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		/* Preserve the captured stock runtime DDR reservation union. */
		nss@40000000 {
			no-map;
			reg = <0 0x40000000 0 0x800000>;
		};
		uboot@4a800000 {
			no-map;
			reg = <0 0x4a800000 0 0x200000>;
		};
		sbl@4aa00000 {
			no-map;
			reg = <0 0x4aa00000 0 0x100000>;
		};

		q6_mem_regions: q6_mem_regions@4b000000 {
			no-map;
			reg = <0x0 0x4b000000 0x0 0x3000000>;
		};

		rsvd1@4e000000 {
			no-map;
			reg = <0 0x4e000000 0 0x80000>;
		};
		rsvd2@4e080000 {
			no-map;
			reg = <0 0x4e080000 0 0x80000>;
		};
	};

	thermal-zones {
		status = "ok";
	};
};

&tlmm {
	#address-cells = <0>;
	blsp_uart0_pins: blsp_uart0_pins {
		pins =
			"gpio20", // RX
			"gpio21"; // TX
		function = "blsp0_uart0";
		drive-strength = <8>;
		bias-disable;
	};

	qspi_nand_pins: qspi_nand_pins {
		clock {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data0 {
			pins = "gpio7";
			function = "qspi0";
			drive-strength = <8>;
			bias-disable;
		};

		data1 {
			pins = "gpio6";
			function = "qspi1";
			drive-strength = <8>;
			bias-disable;
		};

		data2 {
			pins = "gpio5";
			function = "qspi2";
			drive-strength = <8>;
			bias-disable;
		};

		data3 {
			pins = "gpio4";
			function = "qspi3";
			drive-strength = <8>;
			bias-disable;
		};
	};

	mdio1_pins: mdio1_pins {
		mdc {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	leds_pins: leds_pins {
		led_system_blue {
			pins = "gpio24";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		led_system_orange {
			pins = "gpio25";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};


	};

	button_pins: button_pins {
		button_reset {
			pins = "gpio38";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};

		button_mesh {
			pins = "gpio28";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&blsp1_uart1 {
	pinctrl-0 = <&blsp_uart0_pins>;
	pinctrl-names = "default";
	status = "ok";
};

&qpic_bam {
	status = "disabled";
};

&nand {
	pinctrl-0 = <&qspi_nand_pins>;
	pinctrl-names = "default";
	status = "disabled";
};

&soc {
	dma-ranges = <0 0 0 0xffffffff>;
	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_system_blue: led_system_blue {
			label = "blue:system";
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_system_orange: led_system_orange {
			label = "orange:system";
			gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>;
		};


	};

	button {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button_reset {
			label = "reset";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		button_mesh {
			label = "mesh";
			gpios = <&tlmm 28 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};

	ess-instance {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		num_devices = <1>;

		// Dummy switch, to describe how the external ports connects to the MAC
		// For example, some chips have PSGMII ports which combine 5 MAC into
		// 1 external port.
		// For IPQ50xx, this is used to choose SGMII or SGMII-plus
		ess-switch@0x39c00000 {
			compatible = "qcom,ess-switch-ipq50xx";
			device_id = <0>;

			cmnblk_clk = "internal_96MHz";

			// MAC1 Mode
			switch_mac_mode = <0xc>; // PORT_WRAPPER_SGMII_PLUS
			// switch_mac_mode = <0xf>; // PORT_WRAPPER_SGMII_CHANNEL0

			qcom,port_phyinfo {
				// MAC0 -> GE Phy -> YT9215 Phy4
				port@0 {
					port_id = <1>;

					mdiobus = <&mdio0>;
					phy_address = <7>;

					phy_dac = <0x10 0x10>;
				};

				// MAC1 ---SGMII---> YT9215 SerDes
				port@1 {
					port_id = <2>;

					forced-speed = <2500>;
					forced-duplex = <1>;
				};
			};
		};
	};

	// MAC0 -> GE Phy
	mac0: dp1 {
		compatible = "qcom,nss-dp";
		device_type = "network";
		qcom,id = <1>;

		reg = <0x39C00000 0x10000>;
		interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_SNOC_GMAC0_AXI_CLK>;
		clock-names = "nss-snoc-gmac-axi-clk";

		qcom,mactype = <2>; // GMAC_HAL_TYPE_SYN_GMAC
		local-mac-address = [000000000000];
		phy-handle = <&ge_phy>;
		phy-mode = "internal";
	};

	// MAC1 ---SGMII---> YT9215 SerDes
	mac1: dp2 {
		compatible = "qcom,nss-dp";
		device_type = "network";
		qcom,id = <2>;

		reg = <0x39D00000 0x10000>;
		interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_SNOC_GMAC1_AXI_CLK>;
		clock-names = "nss-snoc-gmac-axi-clk";

		qcom,mactype = <2>; // GMAC_HAL_TYPE_SYN_GMAC
		local-mac-address = [000000000000];
		phy-mode = "2500base-x";
	};
};

&mdio0 {
	status = "ok";

	resets = <&gcc GCC_GEPHY_MDC_SW_ARES>;
	reset-names = "phy";

	// IPQ5018 GE Phy -> YT9215 Phy4
	ge_phy: ethernet-phy@7 {
		reg = <7>;
	};
};

&mdio1 {
	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	status = "ok";

	// Motorcomm YT9215
	yt9215: switch@1d {
		compatible = "motorcomm,yt9215-smi";
		reg = <29>;
		switchid = <0>;

		reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
		reset-assert-us = <100000>; /* stock driver: 100-110 ms */
		reset-deassert-us = <150000>; /* stock driver: 150-200 ms */

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			// External jack 4 (stock API maps 4 - jack to PHY)
			port@0 {
				reg = <0>;
			};

			// External jack 3
			port@1 {
				reg = <1>;
			};

			// External jack 2
			port@2 {
				reg = <2>;
			};

			// External jack 1; initial candidate WAN
			port@3 {
				reg = <3>;
			};

			// MAC4 -> Phy4 -> IPQ5018 GE Phy
			port@4 {
				reg = <4>;
			};

			// MAC8 ---SGMII+---> IPQ5018 MAC1
			port@8 {
				reg = <8>;
				phy-mode = "2500base-x";

				fixed-link {
					speed = <2500>;
					full-duplex;
				};
			};
		};
	};
};

&intc {
	#address-cells = <1>;
	#size-cells = <1>;
};

/* Wireless memory layout/firmware compatibility still needs validation. */
&q6v5_wcss { status = "disabled"; };
&wifi0 { qcom,board_id = <0x23>; status = "disabled"; };
&wifi1 { qcom,board_id = <0x60>; status = "disabled"; };
